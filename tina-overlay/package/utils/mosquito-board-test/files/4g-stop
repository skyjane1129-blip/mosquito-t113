#!/bin/sh

PID_FILE=/var/run/ppp-air780eg.pid

if [ ! -r "$PID_FILE" ]; then
	echo '[INFO] Air780EG PPP is not running'
	exit 0
fi
PID="$(sed -n '1p' "$PID_FILE" 2>/dev/null)"
case "$PID" in
	''|*[!0-9]*)
		echo '[WARN] invalid PPP PID file; removing it' >&2
		rm -f "$PID_FILE"
		exit 1
		;;
esac
if kill -0 "$PID" 2>/dev/null; then
	kill -TERM "$PID"
	WAIT=0
	while kill -0 "$PID" 2>/dev/null && [ "$WAIT" -lt 10 ]; do
		sleep 1
		WAIT=$((WAIT + 1))
	done
fi
if kill -0 "$PID" 2>/dev/null; then
	echo "[FAIL] pppd PID $PID did not stop" >&2
	exit 1
fi
rm -f "$PID_FILE"
echo '[PASS] Air780EG PPP data connection stopped'
