#!/bin/sh

GADGET=/sys/kernel/config/usb_gadget/g1
FFS=/dev/usb-ffs/adb
TMP_LOG=/tmp/mosquito-usb0-adb.log
PERSIST_DIR=/overlay/mosquito-test
MODE="${1:-all}"

mkdir -p "$PERSIST_DIR"

log()
{
	echo "$*"
	echo "$*" >> "$TMP_LOG"
}

fail()
{
	log "[FAIL] $*"
	cp "$TMP_LOG" "$PERSIST_DIR/usb0-adb.log" 2>/dev/null
	exit 1
}

set_device_role()
{
	found=0
	for role in /sys/devices/platform/*/*/otg_role; do
		[ -e "$role" ] || continue
		found=1
		echo usb_device > "$role" || return 1
		log "[PASS] USB0 role is $(cat "$role" 2>/dev/null)"
		break
	done
	[ "$found" -eq 1 ] || log '[WARN] otg_role control was not found; keeping the device-tree default'
	return 0
}

prepare()
{
	log '[STEP] preparing ADB without binding the USB controller'
	grep -q ' /sys/kernel/config configfs ' /proc/mounts || \
		mount -t configfs none /sys/kernel/config || fail 'cannot mount configfs'

	BOUND="$(cat "$GADGET/UDC" 2>/dev/null)"
	if [ -n "$BOUND" ]; then
		fail 'gadget is already bound; run usb0-adb-stop before preparing it again'
	fi

	mkdir -p "$GADGET/strings/0x409" || fail 'cannot create gadget strings'
	echo 0x18d1 > "$GADGET/idVendor" || fail 'cannot set USB vendor ID'
	echo 0xD002 > "$GADGET/idProduct" || fail 'cannot set USB product ID'
	echo 0x0100 > "$GADGET/bcdDevice"
	echo 0x0200 > "$GADGET/bcdUSB"
	echo MOSQUITO-T113-DEV > "$GADGET/strings/0x409/serialnumber"
	echo 'Mosquito Project' > "$GADGET/strings/0x409/manufacturer"
	echo 'Mosquito T113 Dev v2' > "$GADGET/strings/0x409/product"

	mkdir -p "$GADGET/configs/c.1/strings/0x409" || fail 'cannot create gadget configuration'
	echo 0xc0 > "$GADGET/configs/c.1/bmAttributes"
	echo 250 > "$GADGET/configs/c.1/MaxPower"
	echo 'Manual ADB development' > "$GADGET/configs/c.1/strings/0x409/configuration"
	mkdir -p "$GADGET/functions/ffs.adb" || fail 'cannot create FunctionFS ADB function'
	# This vendor ConfigFS rejects a ../../functions/... target passed from
	# outside the gadget directory.  Create the link from the gadget root,
	# matching the syntax accepted by the T113 5.4 kernel.
	if [ ! -e "$GADGET/configs/c.1/ffs.adb" ]; then
		(
			cd "$GADGET" || exit 1
			ln -s functions/ffs.adb configs/c.1/
		) || fail 'cannot link the ADB function'
	fi

	mkdir -p "$FFS"
	grep -q " $FFS functionfs " /proc/mounts || \
		mount -t functionfs -o uid=0,gid=0 adb "$FFS" || fail 'cannot mount ADB FunctionFS'

	/etc/init.d/adbd start || fail 'cannot start adbd'
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		[ -e "$FFS/ep1" ] && pidof adbd >/dev/null 2>&1 && break
		attempt=$((attempt + 1))
		usleep 100000
	done
	[ -e "$FFS/ep1" ] || fail 'adbd did not publish its FunctionFS endpoints'
	pidof adbd >/dev/null 2>&1 || fail 'adbd exited during preparation'
	log '[PASS] ADB is prepared; UDC is still deliberately unbound'
	log '[NEXT] wait at least 10 seconds and run: usb0-adb-start bind'
}

wait_until_safe()
{
	while :; do
		up="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
		case "$up" in ''|*[!0-9]*) up=0 ;; esac
		[ "$up" -ge 10 ] && return 0
		log "[INFO] waiting for stable userspace before UDC bind (${up}/10 seconds)"
		sleep 1
	done
}

bind_udc()
{
	log '[STEP] binding the prepared ADB gadget to USB0'
	[ -e "$FFS/ep1" ] || fail 'ADB is not prepared; run usb0-adb-start prepare first'
	pidof adbd >/dev/null 2>&1 || fail 'adbd is not running; run usb0-adb-start prepare first'
	wait_until_safe
	set_device_role || fail 'cannot select USB device role'

	attempt=0
	UDC=
	while [ "$attempt" -lt 50 ]; do
		UDC="$(ls /sys/class/udc 2>/dev/null | sed -n '1p')"
		[ -n "$UDC" ] && break
		attempt=$((attempt + 1))
		usleep 100000
	done
	[ -n "$UDC" ] || fail 'no USB device controller appeared'

	BOUND="$(cat "$GADGET/UDC" 2>/dev/null)"
	if [ -n "$BOUND" ]; then
		[ "$BOUND" = "$UDC" ] || fail "gadget is already bound to unexpected UDC $BOUND"
		log "[INFO] gadget is already bound to $UDC"
	else
		echo "$UDC" > "$GADGET/UDC" || fail 'kernel rejected the UDC bind'
		log "[PASS] gadget bound to $UDC"
	fi
	sleep 1
	STATE="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null)"
	log "[INFO] UDC state: ${STATE:-unknown}"
	log '[NEXT] connect USB0 to the PC, then run adb devices on the PC'
}

case "$MODE" in
prepare)
	: > "$TMP_LOG"
	prepare
	;;
bind)
	bind_udc
	;;
all)
	: > "$TMP_LOG"
	prepare
	bind_udc
	;;
*)
	echo 'Usage: usb0-adb-start [prepare|bind|all]'
	exit 2
	;;
esac

log "Logs: $TMP_LOG and $PERSIST_DIR/usb0-adb.log"
cp "$TMP_LOG" "$PERSIST_DIR/usb0-adb.log" 2>/dev/null
