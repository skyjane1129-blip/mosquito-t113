<UserControl x:Class="Mosquito.Client.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><WrapPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="设备编号 · 留空查询全部" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Device, UpdateSourceTrigger=PropertyChanged}" Width="190"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="检查范围" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="125"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="开始日期（北京时间）" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding From}" Width="145"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="结束日期（含当日）" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding To}" Width="145"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="上报状态" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="135"/></StackPanel>
            <Button Content="查询" Command="{Binding QueryCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0,20,0,0"/>
        </WrapPanel></Border>
        <Border Grid.Row="1" Background="#FFF7E6" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"><StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#865B19" FontSize="13"/>
            <TextBlock Text="{Binding CheckedLabel}" Foreground="#896C3E" FontSize="12" Margin="0,5,0,0"/>
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="计划上报时间" Binding="{Binding ExpectedDisplay}" Width="190"/>
                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceId}" Width="*"/>
                    <DataGridTextColumn Header="上报状态" Binding="{Binding StateDisplay}" ElementStyle="{StaticResource StatusText}" Width="130"/>
                    <DataGridTextColumn Header="实际接收时间" Binding="{Binding ReceivedDisplay}" Width="190"/>
                    <DataGridTextColumn Header="数据说明" Binding="{Binding Note}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False">
                <TextBlock Text="暂无可展示的时段检查结果" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="仅检查已确认生效的计划；未知计划不会被判定为漏报。" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0"/><Button Content="下一页" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7"/></StackPanel>
                <TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><DockPanel>
            <Button Content="查看关联记录" Command="{Binding ViewRecordCommand}" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"/>
            <TextBlock Text="{Binding SelectedNote}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel></Border>
    </Grid>
</UserControl>
