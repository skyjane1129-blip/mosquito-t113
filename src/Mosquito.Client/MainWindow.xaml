<Window x:Class="Mosquito.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Mosquito.Client"
 Title="智能诱蚊诱卵采集平台" Width="1500" Height="960" MinWidth="1180" MinHeight="800" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#233D55">
 <Window.Resources>
  <Style x:Key="HeaderModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="Background" Value="#17496F"/><Setter Property="Foreground" Value="#DCE9F3"/><Setter Property="Padding" Value="20,9"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="{StaticResource PrimaryBrush}"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="20"><TextBlock Text="M" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Margin="14,0,0,0"><TextBlock Text="智能诱蚊诱卵采集平台" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="MOSQUITO   /   影像 · 环境 · 设备信息" Foreground="#C9D9E8" FontSize="11" Margin="0,3,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="LoginPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="{Binding LoginMessage}" ToolTip="{Binding LoginMessage}" Foreground="#B7E8E1" FontSize="12" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/>
    <Grid Width="126" Height="36" Margin="4,0" IsEnabled="{Binding IsLoginEditable}">
     <TextBox x:Name="AccountInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ToolTip="账号" AutomationProperties.Name="账号" Padding="10,7"/>
     <TextBlock Text="账号" Foreground="#64748B" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Username}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Grid Width="126" Height="36" Margin="4,0" IsEnabled="{Binding IsLoginEditable}">
     <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Padding="10,7" FontSize="14" BorderBrush="#CBD5E1" ToolTip="密码" AutomationProperties.Name="密码"/>
     <TextBlock Text="密码" Foreground="#64748B" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPassword}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button x:Name="LoginButton" Content="登录" Command="{Binding LoginCommand}" IsDefault="True" Style="{StaticResource AccentButton}" Height="36" Padding="18,8" Margin="8,0,0,0"/>
   </StackPanel>
   <StackPanel x:Name="ModePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="{Binding IdentityLabel}" ToolTip="{Binding IdentityLabel}" Foreground="#B7E8E1" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,18,0"/>
    <Button Content="直连模式" Command="{Binding DirectModeCommand}" ToolTip="Type-C / ADB · 本机采集与数据传输">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HeaderModeButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDirect}" Value="True"><Setter Property="Background" Value="#0F8C8D"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Button Content="远程模式" Command="{Binding RemoteModeCommand}" Margin="4,0,0,0" ToolTip="每小时自动上报 · 地图与云端记录">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HeaderModeButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRemote}" Value="True"><Setter Property="Background" Value="#0F8C8D"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Button Content="退出登录" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#DCE9F3" BorderBrush="#61819D" BorderThickness="1" Padding="14,8" Margin="20,0,0,0" ToolTip="正在进行直连操作时，请等待操作结束"/>
   </StackPanel>
  </Grid></Border>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="1" IsEnabled="{Binding IsLoggedIn}" Margin="24,14,24,16" SelectedIndex="{Binding Tab}">
   <TabItem Header="采集工作区">
    <Grid Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsDirect, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,14">
        <local:PhotoActions DockPanel.Dock="Right" DataContext="{Binding DirectPhoto}"/>
        <TextBlock Text="采集影像" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <Border Grid.Row="1" Background="#E8EEF3" CornerRadius="6">
        <Grid><TextBlock Text="完成采集后，照片显示在这里" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Image Source="{Binding DirectPhoto.Image}" Stretch="Uniform" Margin="12"/></Grid>
       </Border>
       <StackPanel Grid.Row="2" Margin="0,12,0,0">
        <TextBlock Text="{Binding DirectPhoto.Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Text="原图和传感器数据先保存本机。历史记录从顶部“记录查询”进入。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
      </Grid>
     </Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsRemote, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="16">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel><Button DockPanel.Dock="Right" Content="刷新云端数据" Command="{Binding RefreshRemoteCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8"/><TextBlock Text="设备分布与采集影像" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <StackPanel Grid.Row="1" Margin="0,10,0,8">
        <TextBlock Text="{Binding RegistryMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <Button Content="{Binding AlertSummary}" Command="{Binding OpenOverviewAlertsCommand}" Background="#FFF7E6" Foreground="#865B19" FontSize="12" HorizontalAlignment="Left" Padding="10,7" Margin="0,8,0,0"/>
       </StackPanel>
       <TabControl Grid.Row="2" SelectedIndex="{Binding RemoteView}">
        <TabItem Header="设备地图"><local:ShanghaiMap Margin="0,8,0,0"/></TabItem>
        <TabItem Header="采集影像">
         <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
           <local:PhotoActions DockPanel.Dock="Right" DataContext="{Binding RemotePhoto}"/>
           <TextBlock Text="{Binding SelectedDevice.DeviceId, TargetNullValue=尚未选择设备}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#EDF2F5" CornerRadius="6">
           <Grid><TextBlock Text="先选择设备，查看最近一次采集影像" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Image Source="{Binding RemotePhoto.Image}" Stretch="Uniform" Margin="12"/></Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
           <TextBlock Text="{Binding RemotePhoto.Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
           <TextBlock Text="历史照片从顶部“记录查询”进入；右侧数据始终与当前照片对应。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
         </Grid>
        </TabItem>
       </TabControl>
      </Grid>
     </Border>
     <Grid Grid.Column="2" Visibility="{Binding IsDirect, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
       <StackPanel>
        <DockPanel><Button x:Name="DetectButton" DockPanel.Dock="Right" Content="{Binding DetectionButtonText}" Command="{Binding DetectDeviceCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7"/><TextBlock Text="设备状态" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{Binding DeviceId}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/>
        <TextBlock Text="{Binding DeviceSerial, StringFormat=ADB：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceSerial}"/>
        <TextBlock Text="{Binding ConnectionStatus}" ToolTip="{Binding ConnectionStatus}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="19" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
        <Expander x:Name="DetectionDetails" Header="检测详情" Visibility="{Binding HasDetectionDetails, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="12" Margin="0,6,0,0">
         <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
          <StackPanel>
           <TextBlock Text="{Binding DetectionTime}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
           <ItemsControl ItemsSource="{Binding DetectionChecks}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
         </ScrollViewer>
        </Expander>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
       <StackPanel>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="上传待传记录" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12"/>
         <TextBlock Text="采集操作" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <TextBlock Text="对焦值" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBox Text="{Binding ManualFocus}" Width="70" Padding="8,6"/>
         <CheckBox Content="自动对焦锁定" IsChecked="{Binding UseAutofocusLock}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="CaptureButton" Content="采集并保存本机" Command="{Binding CaptureCommand}" Style="{StaticResource AccentButton}" Padding="10,9"/>
         <Button x:Name="ReadDeviceButton" Grid.Column="2" Content="读取设备信息" Command="{Binding ReadDeviceCommand}" Style="{StaticResource SecondaryButton}" Padding="10,9"/>
        </Grid>
       </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="本次采集结果" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ScrollViewer x:Name="DirectResultsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
          <local:CaptureSummaryView x:Name="DirectCaptureSummary" DataContext="{Binding DirectPhoto}"/>
          <Expander x:Name="LiveReadings" Header="实时读取结果 · 独立测量" IsExpanded="{Binding IsLiveReadingExpanded}" Expanded="LiveReadings_OnExpanded" FontSize="12" Margin="0,16,0,0">
           <StackPanel Margin="0,8,0,0">
            <TextBlock Text="由“读取设备信息”获取，不替换照片的采集数据。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding LiveText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="20"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </Border>
     </Grid>
     <Grid Grid.Column="2" Visibility="{Binding IsRemote, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="设备信息" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="设备编号 · 可直接切换设备" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DeviceId"/>
        <TextBlock Text="{Binding DeviceLocation}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="19" Margin="0,10,0,0"/>
        <Button Content="{Binding AlertMessage}" Command="{Binding OpenAlertCommand}" Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFF0D5" Foreground="#865B19" FontSize="12" Padding="8,10" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="最近一次采集" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
          <StackPanel x:Name="RemotePreview" Visibility="{Binding IsRemoteMap, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
           <Border Background="#EDF2F5" CornerRadius="6" Height="140">
            <Grid><TextBlock Text="选择设备后显示最近影像" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding RemotePhoto.Image}" Stretch="Uniform" Margin="8"/></Grid>
           </Border>
           <local:PhotoActions DataContext="{Binding RemotePhoto}" Margin="0,10,0,0"/>
           <TextBlock Text="{Binding RemotePhoto.Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <local:CaptureSummaryView DataContext="{Binding RemotePhoto}"/>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="记录查询"><TabControl Margin="0,8,0,0" SelectedIndex="{Binding RecordTab}">
    <TabItem Header="采集记录"><local:HistoryView DataContext="{Binding ActiveHistory}" Margin="0,12,0,0"/></TabItem>
    <TabItem Header="上报检查" Visibility="{Binding IsRemote, Converter={StaticResource BooleanToVisibilityConverter}}"><local:ReportsView DataContext="{Binding Reports}" Margin="0,12,0,0"/></TabItem>
   </TabControl></TabItem>
  </TabControl>
  <Border x:Name="LoginLock" Grid.Row="1" Margin="24,14,24,16" Background="#EDF3F6" CornerRadius="8" Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
    <Border Background="#DCEFED" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center"><TextBlock Text="M" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="请先登录" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,12"/>
    <TextBlock Text="在右上角输入账号和密码，登录后选择直连或远程模式。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24"/>
    <TextBlock Text="采集影像 · 环境信息 · 设备位置 · 历史记录" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="#E8EEF3"><DockPanel Margin="24,0"><Button DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,5"/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/></DockPanel></Border>
 </Grid>
</Window>
