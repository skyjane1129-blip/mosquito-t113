<Window x:Class="Mosquito.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="病媒生物现场采集平台"
        Width="1440" Height="900" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="M" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="病媒生物现场采集平台" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="影像 · 环境 · 设备状态一体化采集" Foreground="#C9D9E8" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#9FE4D9" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DeviceSerial}" Foreground="#C9D9E8" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
                <TextBox Grid.Column="3" Margin="8,18,4,18" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="云端账号" />
                <PasswordBox x:Name="PasswordInput" Grid.Column="4" Margin="4,18"
                             PasswordChanged="PasswordInput_OnPasswordChanged" ToolTip="云端密码" />
                <Button Grid.Column="5" Margin="8,18,0,18" Content="登录" Command="{Binding LoginCommand}"
                        Style="{StaticResource AccentButton}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="22" Background="Transparent" BorderThickness="0" FontSize="15">
            <TabItem Header="  采集工作台  ">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="最近一次采集影像" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <Border Grid.Row="1" Margin="0,16" Background="#E8EEF3" CornerRadius="6">
                                <Grid>
                                    <TextBlock Text="完成拍照后在此显示原图" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding PhotoSource}" Stretch="Uniform" Margin="8" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2" Text="原图与元数据在本地落盘后才进入上传队列；上传失败不会删除照片。"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="实时设备状态" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshDeviceCommand}"
                                                Style="{StaticResource SecondaryButton}" Padding="12,6" />
                                    </DockPanel>
                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <Border Background="#EEF7F7" CornerRadius="6" Padding="14" Margin="0,0,6,6">
                                            <StackPanel><TextBlock Text="温度" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Temperature}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Background="#EEF7F7" CornerRadius="6" Padding="14" Margin="6,0,0,6">
                                            <StackPanel><TextBlock Text="湿度" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Humidity}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Background="#EEF3F8" CornerRadius="6" Padding="14" Margin="0,6,6,0">
                                            <StackPanel><TextBlock Text="电池电压" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Battery}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Background="#EEF3F8" CornerRadius="6" Padding="14" Margin="6,6,0,0">
                                            <StackPanel><TextBlock Text="充电状态" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding ChargeState}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SensorWarning}" Foreground="#B45309" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="电量仅显示芯片可证明的电压和充电状态，不估算百分比。"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="采集设置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="上传通道" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5" />
                                    <ComboBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" />
                                    <CheckBox Content="使用自动对焦稳定后锁定" IsChecked="{Binding UseAutofocusLock}"
                                              Margin="0,14,0,8" FontSize="14" />
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="手动焦距" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Text="{Binding ManualFocus, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Text="默认焦距 500；自动对焦会稳定采样后锁定再拍摄。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14" />
                                    <Button Content="一键拍照并上传" Command="{Binding CaptureCommand}"
                                            Style="{StaticResource AccentButton}" FontSize="18" Padding="22,15" />
                                    <ProgressBar Height="8" Margin="0,14,0,8" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="取消当前操作" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                        <Button Content="重试待上传" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="  记录查询  ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="120" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" />
                                <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="18,0,8,0" />
                                <DatePicker Width="145" SelectedDate="{Binding FilterFrom}" />
                                <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="18,0,8,0" />
                                <DatePicker Width="145" SelectedDate="{Binding FilterTo}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="查询" Command="{Binding RefreshGalleryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="导出 CSV" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <DataGrid ItemsSource="{Binding Captures}" SelectedItem="{Binding SelectedCapture}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" RowHeight="38" AlternatingRowBackground="#F8FAFC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="拍摄时间 UTC" Binding="{Binding CapturedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85" />
                                    <DataGridTextColumn Header="温度" Binding="{Binding Environment.TemperatureDisplay}" Width="90" />
                                    <DataGridTextColumn Header="湿度" Binding="{Binding Environment.HumidityDisplay}" Width="100" />
                                    <DataGridTextColumn Header="电池" Binding="{Binding Power.BatteryDisplay}" Width="90" />
                                    <DataGridTextColumn Header="充电" Binding="{Binding Power.ChargeDisplay}" Width="100" />
                                    <DataGridTextColumn Header="设备序列号" Binding="{Binding DeviceSerial}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="220" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="记录详情" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                <Border Grid.Row="1" Margin="0,14" Background="#E8EEF3" CornerRadius="6">
                                    <Image Source="{Binding PhotoSource}" Stretch="Uniform" Margin="6" />
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding DetailText}" TextWrapping="Wrap" LineHeight="24" />
                                <Button Grid.Row="3" Content="查看所选记录" Command="{Binding LoadDetailCommand}"
                                        Style="{StaticResource PrimaryButton}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8EEF3" BorderBrush="#D7E0E8" BorderThickness="0,1,0,0">
            <DockPanel Margin="22,0">
                <TextBlock Text="DEMO ONLY · 当前自动 ADB 方案仅用于受控演示镜像" Foreground="#9A3412" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CloudStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
