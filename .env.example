ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
Auth__Username=operator
Auth__Password=REPLACE_WITH_SECRET
Auth__SigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DeviceAuth__ApiKey=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Repository__Provider=Postgres
Repository__ConnectionString=Host=127.0.0.1;Port=5432;Database=mosquito;Username=mosquito_api;Password=REPLACE_WITH_SECRET;SSL Mode=VerifyFull;Root Certificate=/etc/ssl/certs/aliyun-rds-ca.pem
Storage__Provider=AliyunOss
Storage__PublicBaseUrl=https://capture-api.example.cn
Storage__Region=cn-hangzhou
Storage__Endpoint=https://oss-cn-hangzhou.aliyuncs.com
Storage__Bucket=REPLACE_WITH_PRIVATE_BUCKET
Storage__EcsRamRoleName=REPLACE_WITH_ECS_RAM_ROLE
